{"userName":"546508b9842c4e3698a1f2d3ae6fa917","encoding":"0","time":"2025-12-11 12:17:11","sql":"COMMENT ON COLUMN \"${schemaName}\".\"review\".\"id\" IS '';\nCOMMENT ON COLUMN \"${schemaName}\".\"review\".\"module_code\" IS '';\nCOMMENT ON COLUMN \"${schemaName}\".\"review\".\"dept_id\" IS '';\nCOMMENT ON COLUMN \"${schemaName}\".\"review\".\"review_id\" IS '';\nCOMMENT ON COLUMN \"${schemaName}\".\"review\".\"review_content\" IS '';\nCOMMENT ON COLUMN \"${schemaName}\".\"review\".\"review_time\" IS '';\nCOMMENT ON COLUMN \"${schemaName}\".\"review\".\"user_id\" IS '';\nCOMMENT ON COLUMN \"${schemaName}\".\"review\".\"content_id\" IS '';\ndo $$begin IF EXISTS (SELECT 1 FROM \"information_schema\".\"table_constraints\" tc WHERE tc.\"constraint_name\"='review_user_id_fkey') then \nALTER TABLE \"${schemaName}\".\"review\" DROP CONSTRAINT \"review_user_id_fkey\" CASCADE;\nEND if;end $$;\ndo $$begin IF EXISTS (SELECT 1 FROM \"information_schema\".\"table_constraints\" tc WHERE tc.\"constraint_name\"='review_content_id_fkey') then \nALTER TABLE \"${schemaName}\".\"review\" DROP CONSTRAINT \"review_content_id_fkey\" CASCADE;\nEND if;end $$;\nALTER TABLE \"${schemaName}\".\"review\" ADD CONSTRAINT \"review_user_id_fkey\" FOREIGN KEY (user_id) REFERENCES contentmanagement.user (user_id) MATCH SIMPLE ON DELETE NO ACTION ON UPDATE CASCADE ENABLE VALIDATE;\nALTER TABLE \"${schemaName}\".\"review\" ADD CONSTRAINT \"review_content_id_fkey\" FOREIGN KEY (content_id) REFERENCES contentmanagement.content (content_id) MATCH SIMPLE ON DELETE NO ACTION ON UPDATE CASCADE ENABLE VALIDATE;\n"}
