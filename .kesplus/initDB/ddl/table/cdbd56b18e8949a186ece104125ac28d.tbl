{"userName":"546508b9842c4e3698a1f2d3ae6fa917","encoding":"0","time":"2025-12-10 15:42:44","sql":"COMMENT ON COLUMN \"${schemaName}\".\"content\".\"id\" IS '';\nCOMMENT ON COLUMN \"${schemaName}\".\"content\".\"module_code\" IS '';\nCOMMENT ON COLUMN \"${schemaName}\".\"content\".\"dept_id\" IS '';\nCOMMENT ON COLUMN \"${schemaName}\".\"content\".\"content_id\" IS '';\nCOMMENT ON COLUMN \"${schemaName}\".\"content\".\"title\" IS '';\nCOMMENT ON COLUMN \"${schemaName}\".\"content\".\"url\" IS '';\nCOMMENT ON COLUMN \"${schemaName}\".\"content\".\"publish_time\" IS '';\nCOMMENT ON COLUMN \"${schemaName}\".\"content\".\"publisher\" IS '';\nCOMMENT ON COLUMN \"${schemaName}\".\"content\".\"type\" IS '';\nCOMMENT ON COLUMN \"${schemaName}\".\"content\".\"classify_id\" IS '';\ndo $$begin IF EXISTS (SELECT 1 FROM \"information_schema\".\"table_constraints\" tc WHERE tc.\"constraint_name\"='分类ID') then \nALTER TABLE \"${schemaName}\".\"content\" DROP CONSTRAINT \"分类ID\" CASCADE;\nEND if;end $$;\nALTER TABLE \"${schemaName}\".\"content\" ADD CONSTRAINT \"分类ID\" FOREIGN KEY (classify_id) REFERENCES contentmanagement.classify (classify_id) MATCH FULL ON DELETE NO ACTION ON UPDATE NO ACTION ENABLE VALIDATE;\n"}
