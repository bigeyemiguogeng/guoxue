{"userName":"546508b9842c4e3698a1f2d3ae6fa917","encoding":"0","time":"2025-12-11 12:16:49","sql":"COMMENT ON COLUMN \"${schemaName}\".\"collection\".\"id\" IS '';\nCOMMENT ON COLUMN \"${schemaName}\".\"collection\".\"module_code\" IS '';\nCOMMENT ON COLUMN \"${schemaName}\".\"collection\".\"dept_id\" IS '';\nCOMMENT ON COLUMN \"${schemaName}\".\"collection\".\"collection_time\" IS '';\nCOMMENT ON COLUMN \"${schemaName}\".\"collection\".\"collection_state\" IS '';\nCOMMENT ON COLUMN \"${schemaName}\".\"collection\".\"user_id\" IS '';\nCOMMENT ON COLUMN \"${schemaName}\".\"collection\".\"content_id\" IS '';\ndo $$begin IF EXISTS (SELECT 1 FROM \"information_schema\".\"table_constraints\" tc WHERE tc.\"constraint_name\"='collection_content_id_fkey') then \nALTER TABLE \"${schemaName}\".\"collection\" DROP CONSTRAINT \"collection_content_id_fkey\" CASCADE;\nEND if;end $$;\ndo $$begin IF EXISTS (SELECT 1 FROM \"information_schema\".\"table_constraints\" tc WHERE tc.\"constraint_name\"='collection_user_id_fkey') then \nALTER TABLE \"${schemaName}\".\"collection\" DROP CONSTRAINT \"collection_user_id_fkey\" CASCADE;\nEND if;end $$;\nALTER TABLE \"${schemaName}\".\"collection\" ADD CONSTRAINT \"collection_content_id_fkey\" FOREIGN KEY (content_id) REFERENCES contentmanagement.content (content_id) MATCH SIMPLE ON DELETE NO ACTION ON UPDATE CASCADE ENABLE VALIDATE;\nALTER TABLE \"${schemaName}\".\"collection\" ADD CONSTRAINT \"collection_user_id_fkey\" FOREIGN KEY (user_id) REFERENCES contentmanagement.user (user_id) MATCH SIMPLE ON DELETE NO ACTION ON UPDATE CASCADE ENABLE VALIDATE;\n"}
